BATTLENESS_APP_ENV="production"
BATTLENESS_PUBLIC_ORIGIN="https://battleness.com"
BATTLENESS_DATABASE_URL="postgresql://battleness:replace-with-password@replace-with-db-host:5432/battleness_production?schema=public"
BATTLENESS_DEV_AUTH="disabled"

GOOGLE_OAUTH_CLIENT_ID="replace-with-production-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="replace-with-production-google-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="https://battleness.com/api/auth/google/callback"

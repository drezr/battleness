BATTLENESS_APP_ENV="staging"
BATTLENESS_PUBLIC_ORIGIN="https://staging.battleness.com"
BATTLENESS_DATABASE_URL="postgresql://battleness:replace-with-password@replace-with-db-host:5432/battleness_staging?schema=public"
BATTLENESS_DEV_AUTH="disabled"

GOOGLE_OAUTH_CLIENT_ID="replace-with-staging-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="replace-with-staging-google-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="https://staging.battleness.com/api/auth/google/callback"

{
  "name": "@battleness/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:postgres": "pnpm prisma:postgres:generate && nuxt build",
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "dev:oauth": "nuxt dev --host 127.0.0.1 --port 3000 --dotenv .env.oauth.local",
    "prebuild": "pnpm prisma:generate",
    "pretypecheck": "pnpm prisma:generate",
    "preview": "nuxt preview --host 127.0.0.1",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:postgres:check": "node scripts/prepare-postgresql-schema.mjs --check",
    "prisma:postgres:prepare": "node scripts/prepare-postgresql-schema.mjs",
    "prisma:postgres:validate": "prisma validate --schema prisma/postgresql/schema.prisma",
    "prisma:postgres:generate": "pnpm prisma:postgres:prepare && prisma generate --schema prisma/postgresql/schema.prisma",
    "prisma:postgres:migrate:dev": "pnpm prisma:postgres:prepare && prisma migrate dev --schema prisma/postgresql/schema.prisma",
    "prisma:postgres:migrate:deploy": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "prisma:postgres:migrate:status": "prisma migrate status --schema prisma/postgresql/schema.prisma",
    "prisma:postgres:drift:check": "prisma migrate diff --from-schema-datasource prisma/postgresql/schema.prisma --to-schema-datamodel prisma/postgresql/schema.prisma --exit-code",
    "prisma:postgres:smoke": "node scripts/postgresql-smoke.mjs",
    "staging:reset-gameplay": "pnpm prisma:postgres:generate && node scripts/reset-staging-gameplay.mjs",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@battleness/content": "workspace:*",
    "@battleness/engine": "workspace:*",
    "@lucide/vue": "^1.24.0",
    "@nuxtjs/i18n": "^10.4.1",
    "@prisma/client": "^6.19.0",
    "h3": "^1.15.4",
    "nuxt": "^4.2.2",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.7"
  }
}

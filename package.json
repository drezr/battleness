{
  "name": "battleness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @battleness/prototype dev",
    "dev:web": "pnpm --filter @battleness/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "validate:content": "pnpm --filter @battleness/content validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.13"
  }
}

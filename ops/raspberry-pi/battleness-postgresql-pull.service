[Unit]
Description=Pull encrypted BattleNess PostgreSQL backups
After=network-online.target
Wants=network-online.target
Documentation=file:/usr/local/share/battleness/postgresql-backup/DEPLOYMENT.md

[Service]
Type=oneshot
User=drezr
Group=drezr
Environment=BACKUP_ROOT=/home/drezr/bn/postgresql
Environment=REMOTE_TARGET=battleness-backup-pull@51.91.159.196
Environment=REMOTE_PATH=/
Environment=SSH_KEY=/home/drezr/.ssh/battleness_backup_pull_ed25519
Environment=SSH_KNOWN_HOSTS=/home/drezr/.ssh/battleness_backup_known_hosts
Environment=RETENTION_DAYS=90
Environment=MAX_BACKUP_AGE_SECONDS=129600
ExecStart=/usr/local/sbin/battleness-postgresql-pull
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/drezr/.ssh
ReadWritePaths=/home/drezr/bn

[Install]
WantedBy=multi-user.target
